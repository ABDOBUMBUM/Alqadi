generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════
// الموظفون — مجموعة القاضي الذهبية
// ═══════════════════════════════════════════════════
model Employee {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  password    String   @db.VarChar(255)
  role        String   @default("agent") @db.VarChar(20)
  title       String?
  email       String?
  phone       String?
  shift       String?  // e.g. "صباحي" (Morning), "مسائي" (Evening)
  branchId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch      Branch?  @relation(fields: [branchId], references: [id])

  sessions    Session[]
  leads       Lead[]
  bookings    Booking[]
  auditLogs   AuditLog[]

  @@index([username])
  @@index([branchId])
  @@map("employee")
}

// ═══════════════════════════════════════════════════
// الجلسات — لنظام المصادقة
// ═══════════════════════════════════════════════════
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  employeeId   String
  expires      DateTime
  createdAt    DateTime @default(now())

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([employeeId])
  @@map("session")
}

// ═══════════════════════════════════════════════════
// الفنادق
// ═══════════════════════════════════════════════════
model Hotel {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  city        String
  country     String
  stars       Int      @default(4)
  description String?  @db.Text
  priceFrom   Float    @default(0)
  currency    String   @default("KWD")
  images      Json?
  imageUrl    String?
  amenities   Json?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  externalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       Room[]

  @@index([city])
  @@index([country])
  @@index([featured])
  @@map("hotel")
}

// ═══════════════════════════════════════════════════
// الغرف
// ═══════════════════════════════════════════════════
model Room {
  id          String   @id @default(cuid())
  hotelId     String
  type        String
  price       Float
  currency    String   @default("KWD")
  capacity    Int      @default(2)
  available   Boolean  @default(true)
  images      Json?
  amenities   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([type])
  @@map("room")
}

// ═══════════════════════════════════════════════════
// التأشيرات
// ═══════════════════════════════════════════════════
model Visa {
  id            String   @id @default(cuid())
  country       String
  countryEn     String?
  type          String   @default("tourism")
  price         Float    @default(0)
  currency      String   @default("KWD")
  processingDays Int     @default(7)
  requirements  Json?
  documents     Json?
  description   String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([country])
  @@index([type])
  @@map("visa")
}

// ═══════════════════════════════════════════════════
// العملاء المحتملين (Leads)
// ═══════════════════════════════════════════════════
model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  service     String?
  message     String?  @db.Text
  status      String   @default("new") @db.VarChar(20)
  source      String   @default("website")
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee? @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedTo])
  @@index([email])
  @@map("lead")
}

// ═══════════════════════════════════════════════════
// الأيدي العاملة (الوظائف)
// ═══════════════════════════════════════════════════
model Job {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?
  category    String   @default("general")
  country     String
  salary      Float    @default(0)
  currency    String   @default("KWD")
  experience  String?
  description String?  @db.Text
  requirements Json?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([country])
  @@map("job")
}

// ═══════════════════════════════════════════════════
// إعدادات الموقع
// ═══════════════════════════════════════════════════
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("sitesetting")
}

// ═══════════════════════════════════════════════════
// إدارة العملاء (CRM)
// ═══════════════════════════════════════════════════
model Client {
  id          String    @id @default(cuid())
  name        String
  email       String?   @unique
  phone       String?   @unique
  passportNo  String?
  nationality String?
  loyaltyPts  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]
  tickets     SupportTicket[]

  @@map("client")
}

// ═══════════════════════════════════════════════════
// الحجوزات والمبيعات (Bookings & Sales)
// ═══════════════════════════════════════════════════
model Booking {
  id          String   @id @default(cuid())
  clientId    String
  employeeId  String?
  serviceType String   @db.VarChar(30)
  status      String   @default("pending") @db.VarChar(20)
  totalAmount Float    @default(0)
  paidAmount  Float    @default(0)
  currency    String   @default("KWD")
  details     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id])
  employee    Employee? @relation(fields: [employeeId], references: [id])

  @@index([clientId])
  @@index([employeeId])
  @@map("booking")
}

// ═══════════════════════════════════════════════════
// تذاكر الدعم الفني (Support Tickets)
// ═══════════════════════════════════════════════════
model SupportTicket {
  id          String   @id @default(cuid())
  clientId    String
  subject     String
  description String   @db.Text
  status      String   @default("open") @db.VarChar(20)
  priority    String   @default("medium") @db.VarChar(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@map("supportticket")
}

// ═══════════════════════════════════════════════════
// قواعد البيانات الديناميكية (Dynamic Entity Manager)
// ═══════════════════════════════════════════════════
model DynamicSchema {
  id          String   @id @default(cuid())
  name        String   @unique
  labelAr     String
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records     DynamicRecord[]

  @@map("dynamicschema")
}

model DynamicRecord {
  id        String   @id @default(cuid())
  schemaId  String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schema    DynamicSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@index([schemaId])
  @@map("dynamicrecord")
}

// ═══════════════════════════════════════════════════
// الأسعار والتسعير (Pricing)
// ═══════════════════════════════════════════════════
model Pricing {
  id          String   @id @default(cuid())
  destination String
  ticket      Float    @default(0)
  security    Float    @default(0)
  visa        Float    @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pricing")
}

// ═══════════════════════════════════════════════════
// الفروع (Branches)
// ═══════════════════════════════════════════════════
model Branch {
  id        String   @id @default(cuid())
  name      String
  city      String
  phone     String?
  address   String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("branch")
}

// ═══════════════════════════════════════════════════
// محتوى الصفحات (CMS Pages)
// ═══════════════════════════════════════════════════
model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cmspage")
}

// ═══════════════════════════════════════════════════
// الوجهات السياحية (Destinations)
// ═══════════════════════════════════════════════════
model Destination {
  id          String   @id @default(cuid())
  name        String
  country     String
  priceKWD    Float    @default(0)
  lat         Float?
  lng         Float?
  description String?  @db.Text
  imageUrl    String?
  rating      Float    @default(5.0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packages    Package[]

  @@map("destination")
}

// ═══════════════════════════════════════════════════
// الباقات السياحية (Packages)
// ═══════════════════════════════════════════════════
model Package {
  id            String   @id @default(cuid())
  title         String
  destinationId String
  days          Int
  nights        Int
  price         Float
  currency      String   @default("KWD")
  discount      String?
  includes      Json?
  imageUrl      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@map("package")
}

// ═══════════════════════════════════════════════════
// سجل العمليات (Audit Log)
// ═══════════════════════════════════════════════════
model AuditLog {
  id          String   @id @default(cuid())
  employeeId  String?
  action      String
  entity      String
  entityId    String
  details     Json?
  createdAt   DateTime @default(now())

  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([entity])
  @@map("auditlog")
}
