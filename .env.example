# ════════════════════════════════════════════════════════════════
# مجموعة القاضي الذهبية — نموذج ملف البيئة
# ════════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env.local وعدّل القيم
# cp .env.example .env.local

# 🌐 الخادم
NEXT_PUBLIC_SITE_URL=https://alqadigroup.com

# 📞 بيانات الاتصال
NEXT_PUBLIC_WHATSAPP_NUMBER=YOUR_WHATSAPP_NUMBER
NEXT_PUBLIC_PHONE_NUMBER=+YOUR_PHONE_NUMBER
NEXT_PUBLIC_EMAIL=info@your-domain.com

# 🎛️ Feature Flags
NEXT_PUBLIC_FEATURE_FLAGS=

# 📊 Web Vitals
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# 🔗 CRM Webhook
CRM_WEBHOOK_URL=

# ═══ SECURITY — CHANGE ALL VALUES BELOW ═══════════════════════

# 🔐 Admin Panel Password
NEXT_PUBLIC_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# 🔐 Default Employee Password
NEXT_PUBLIC_DEFAULT_EMP_PASSWORD=CHANGE_THIS_TOO

# 🔐 Seed Script Passwords (dev only)
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_AGENT_PASSWORD=CHANGE_ME

# 🗄️ Database
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/alqadi_db"

# 🔑 NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-with-openssl-rand-base64-32
